<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find f1l01_00000000_20260918_new)/urdf/f1l01_00000000_20260918_new.urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find f1l01_00000000_20260918_new)/urdf.rviz" />
</launch>